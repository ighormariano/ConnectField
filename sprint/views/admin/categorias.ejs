<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Categorias | ConnectField</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
  <!-- no <head>, depois do admin.css -->
<link rel="stylesheet" href="/css/rodape.css">
<link rel="stylesheet" href="/css/animacoes.css">
<script src="/js/proteger-admin.js" defer></script>
</head>
<body class="pagina-produtos pagina-admin">
  <% const lista = locals.categorias || []; %>
  <% const f = locals.filtros || {}; %>
  <% const comBaixo = lista.filter(c => Number(c.produtos_baixo) > 0).length; %>

  <%- include('partials/topo', { ativo: 'categorias' }) %>

  <main class="dash container">

    <div class="dash-topo">
      <div>
        <h1>Categorias</h1>
        <p><%= lista.length %> categoria(s) encontrada(s)</p>
      </div>
      <a href="/admin/categorias-form" class="btn-mov cat-novo">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        Nova categoria
      </a>
    </div>

    <% if (locals.mensagem) { %><div class="cat-alerta sucesso"><%= mensagem %></div><% } %>
    <% if (locals.erro) { %><div class="cat-alerta erro"><%= erro %></div><% } %>

    <!-- RESUMO (reaproveita os cards do dashboard) -->
    <section class="indicadores" style="grid-template-columns: repeat(2, 1fr);">
      <article class="indicador">
        <span class="indicador-rotulo">Categorias cadastradas</span>
        <strong class="indicador-valor"><%= lista.length %></strong>
      </article>
      <article class="indicador <%= comBaixo > 0 ? 'alerta-min' : '' %>">
        <span class="indicador-rotulo">Com produtos abaixo do mínimo</span>
        <strong class="indicador-valor"><%= comBaixo %></strong>
      </article>
    </section>

    <!-- BUSCA -->
    <form method="GET" action="/admin/categorias" class="cat-filtros">
      <div class="cat-busca">
        <input type="text" name="q" placeholder="Buscar categorias..." value="<%= f.q || '' %>">
        <button type="submit" aria-label="Buscar">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </button>
      </div>
      <% if (f.q) { %><a href="/admin/categorias" class="cat-limpar">Limpar busca</a><% } %>
    </form>

    <!-- VITRINE DE CATEGORIAS -->
    <section class="cat-grade">

      <% if (lista.length === 0) { %>
        <div class="cat-vazio">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h7l9 9-7 7-9-9z"/><circle cx="8" cy="8" r="1.5"/></svg>
          <p>Nenhuma categoria encontrada.</p>
        </div>
      <% } %>

      <% lista.forEach((c, i) => { %>
        <% const baixo = Number(c.produtos_baixo) > 0; %>
        <article class="cat-card <%= baixo ? 'cat-card--baixo' : '' %>" style="--i: <%= i %>">

          <div class="cat-card-topo">
            <span class="cat-avatar" aria-hidden="true"><%= String(c.nome).charAt(0).toUpperCase() %></span>
            <span class="cat-status <%= baixo ? 'cat-status-baixo' : 'cat-status-ativo' %>">
              <%= baixo ? 'Baixo estoque' : 'Ativo' %>
            </span>
          </div>

          <h2 class="cat-nome"><%= c.nome %></h2>
          <p class="cat-desc"><%= c.descricao || 'Sem descrição.' %></p>

          <div class="cat-rodape">
            <span class="cat-qtd">
              <% if (c.total_produtos !== undefined) { %>
                <strong><%= c.total_produtos %></strong> produto(s)
              <% } else if (baixo) { %>
                <strong><%= c.produtos_baixo %></strong> abaixo do mínimo
              <% } else { %>
                Estoque em dia
              <% } %>
            </span>

            <div class="cat-acoes">
              <a href="/admin/categorias/<%= c.id %>/editar" class="cat-icone" aria-label="Editar <%= c.nome %>" title="Editar">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
              </a>
              <a href="#excluir-<%= c.id %>" class="cat-icone perigo" aria-label="Excluir <%= c.nome %>" title="Excluir">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 11v5M14 11v5"/></svg>
              </a>
            </div>
          </div>

        </article>
      <% }) %>

    </section>
  </main>

  <!-- MODAIS DE EXCLUSÃO -->
  <% lista.forEach(c => { %>
    <div class="cat-modal" id="excluir-<%= c.id %>">
      <a href="#" class="cat-modal-fundo" aria-label="Fechar"></a>
      <div class="cat-modal-caixa" role="dialog" aria-labelledby="titulo-<%= c.id %>">
        <div class="cat-modal-icone">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg>
        </div>
        <h2 id="titulo-<%= c.id %>">Excluir categoria?</h2>
        <p>Você vai excluir <strong><%= c.nome %></strong>. Essa ação não pode ser desfeita.</p>
        <div class="cat-modal-botoes">
          <a href="#" class="cat-btn cat-btn-claro">Cancelar</a>
          <form action="/admin/categorias/<%= c.id %>/excluir" method="POST">
            <button type="submit" class="cat-btn cat-btn-perigo">Sim, excluir</button>
          </form>
        </div>
      </div>
    </div>
  <% }) %>


<!-- logo depois do </main> -->
<%- include('../partials/rodape', { tipo: 'admin' }) %>
</body>
</html>
