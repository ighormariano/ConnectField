<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Produtos | ConnectField</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
  <!-- no <head>, depois do admin.css -->
  <link rel="stylesheet" href="/css/rodape.css">
  <link rel="stylesheet" href="/css/animacoes.css">
  <script src="/js/proteger-admin.js" defer></script>
</head>

<body>
  <% const lista=locals.produtos || []; %>
    <% const cats=locals.categorias || []; %>
      <% const f=locals.filtros || {}; %>

        <%- include('partials/topo', { ativo: 'produtos' }) %>

          <main class="pagina">

            <div class="pagina-cab">
              <div>
                <h1>Produtos</h1>
                <p class="pagina-sub">
                  <%= lista.length %> produto(s) encontrado(s)
                </p>
              </div>
              <a href="/admin/produtos/novo" class="btn btn-primario">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 5v14M5 12h14" />
                </svg>
                Novo Produto
              </a>
            </div>

            <% if (locals.mensagem) { %>
              <div class="alerta sucesso">
                <%= mensagem %>
              </div>
              <% } %>
                <% if (locals.erro) { %>
                  <div class="alerta erro">
                    <%= erro %>
                  </div>
                  <% } %>

                    <!-- FILTROS -->
                    <form method="GET" action="/admin/produtos" class="filtros">
                      <div class="busca">
                        <input type="text" name="q" placeholder="Buscar produtos..." value="<%= f.q || '' %>">
                        <button type="submit" aria-label="Buscar">
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="11" cy="11" r="8" />
                            <path d="m21 21-4.3-4.3" />
                          </svg>
                        </button>
                      </div>

                      <select name="categoria" onchange="this.form.submit()" aria-label="Filtrar por categoria">
                        <option value="">Todas as categorias</option>
                        <% cats.forEach(c=> { %>
                          <option value="<%= c.id %>" <%=String(f.categoria)===String(c.id) ? 'selected' : '' %>><%=
                              c.nome %>
                          </option>
                          <% }) %>
                      </select>

                      <select name="status" onchange="this.form.submit()" aria-label="Filtrar por status">
                        <option value="">Todos os status</option>
                        <option value="ativo" <%=f.status==='ativo' ? 'selected' : '' %>>Ativo</option>
                        <option value="baixo" <%=f.status==='baixo' ? 'selected' : '' %>>Baixo estoque</option>
                      </select>

                      <% if (f.q || f.categoria || f.status) { %>
                        <a href="/admin/produtos" class="limpar">Limpar filtros</a>
                        <% } %>
                    </form>

                    <!-- TABELA -->
                    <div class="tabela-card">
                      <table class="tabela">
                        <thead>
                          <tr>
                            <th>Imagem</th>
                            <th>Nome</th>
                            <th>Categoria</th>
                            <th class="centro">Estoque</th>
                            <th class="centro">Status</th>
                            <th class="centro">Ação</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% if (lista.length===0) { %>
                            <tr class="linha-vazia">
                              <td colspan="6">
                                <div class="vazio">
                                  <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M21 8l-9-5-9 5v8l9 5 9-5z" />
                                    <path d="M3 8l9 5 9-5M12 13v8" />
                                  </svg>
                                  <p>Nenhum produto encontrado.</p>
                                </div>
                              </td>
                            </tr>
                            <% } %>

                              <% lista.forEach((p, i)=> { %>
                                <% const baixo=Number(p.qnt_estoque) <=Number(p.estoque_min); %>
                                  <tr style="--i: <%= i %>">
                                    <td>
                                      <img src="<%= p.imagem || '/img/placeholder.png' %>" class="produto-img"
                                        alt="<%= p.nome %>">
                                    </td>
                                    <td class="nome">
                                      <%= p.nome %>
                                    </td>
                                    <td>
                                      <%= p.categoria_nome || 'Sem categoria' %>
                                    </td>
                                    <td class="centro"><strong>
                                        <%= p.qnt_estoque %>
                                      </strong></td>
                                    <td class="centro">
                                      <span class="status <%= baixo ? 'status-baixo' : 'status-ativo' %>">
                                        <%= baixo ? 'Baixo estoque' : 'Ativo' %>
                                      </span>
                                    </td>
                                    <td class="centro">
                                      <div class="acoes">
                                        <a href="/admin/produtos/<%= p.id %>/editar" class="icone"
                                          aria-label="Editar <%= p.nome %>" title="Editar">
                                          <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M12 20h9" />
                                            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" />
                                          </svg>
                                        </a>
                                        <a href="#excluir-<%= p.id %>" class="icone perigo"
                                          aria-label="Excluir <%= p.nome %>" title="Excluir">
                                          <svg viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 11v5M14 11v5" />
                                          </svg>
                                        </a>
                                      </div>
                                    </td>
                                  </tr>
                                  <% }) %>
                        </tbody>
                      </table>
                    </div>

          </main>

          <!-- CONFIRMAÇÃO DE EXCLUSÃO (só CSS, usa :target) -->
          <% lista.forEach(p=> { %>
            <div class="modal" id="excluir-<%= p.id %>">
              <a href="#" class="modal-fundo" aria-label="Fechar"></a>
              <div class="modal-caixa" role="dialog" aria-labelledby="titulo-<%= p.id %>">
                <div class="modal-icone">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14" />
                  </svg>
                </div>
                <h2 id="titulo-<%= p.id %>">Excluir produto?</h2>
                <p>Você vai excluir <strong>
                    <%= p.nome %>
                  </strong>. Essa ação não pode ser desfeita.</p>
                <div class="modal-botoes">
                  <a href="#" class="btn btn-claro">Cancelar</a>
                  <form action="/admin/produtos/<%= p.id %>/excluir" method="POST">
                    <button type="submit" class="btn btn-perigo">Sim, excluir</button>
                  </form>
                </div>
              </div>
            </div>
            <% }) %>


              <!-- logo depois do </main> -->
              <%- include('../partials/rodape', { tipo: 'admin' }) %>
</body>

</html>