<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login | ConnectField</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/login.css">
  <!-- no <head>, depois do login.css -->
  <link rel="stylesheet" href="/css/rodape.css">
  <link rel="stylesheet" href="/css/animacoes.css">
</head>

<body>
  <main class="login-page">

    <section class="login-logo">
      <img src="/img/logo.png" alt="ConnectField">
    </section>

    <section class="login-card">
      <h1>Acesse sua conta</h1>
      <p class="subtitulo">Bem-vindo de volta! Entre para continuar.</p>

      <% if (locals.erro) { %>
        <div class="alerta erro">
          <%= erro %>
        </div>
        <% } %>

          <% if (locals.sucesso) { %>
            <div class="alerta sucesso">
              <%= sucesso %>
            </div>
            <% } %>

              <form action="/login" method="POST">

                <label class="campo">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="8" r="4" />
                    <path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" />
                  </svg>
                  <input type="text" name="usuario" placeholder="E-mail" required>
                </label>

                <label class="campo">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="8" cy="15" r="4" />
                    <path d="M11 12l9-9M16 7l3 3" />
                  </svg>
                  <input type="password" name="senha" placeholder="Digite sua senha" required>
                  <button type="button" class="ver-senha" aria-label="Mostrar senha">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z" />
                      <circle cx="12" cy="12" r="3" />
                    </svg>
                  </button>
                </label>

                <div class="linha-opcoes">
                  <label class="lembrar">
                    <input type="checkbox" name="lembrar">
                    <span class="caixa"></span>
                    <span class="texto">Lembrar de mim</span>
                  </label>
                  <a href="/esqueci-senha" class="esqueci">Esqueci a senha</a>
                </div>

                <button type="submit" class="btn-acessar">Acessar</button>
              </form>
              <% if (locals.semAdmin) { %>
                <p class="rodape-card">Primeiro acesso? <a href="/cadastro">Criar conta de administrador</a></p>
              <% } %>
    </section>

  </main>
  <script src="/js/auth.js"></script>


  <!-- logo depois do </main>, antes do <script> -->
  <%- include('partials/rodape', { tipo: 'login' }) %>
</body>

</html>