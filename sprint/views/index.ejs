<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ConectField</title>
    <link rel="stylesheet" href="css/style.css">
    <!-- no <head>, depois do style.css -->
    <link rel="stylesheet" href="/css/rodape.css">
    <link rel="stylesheet" href="/css/animacoes.css">
</head>

<body>
    <!-- CABEÇALHO -->
    <header class="cabecalho">
        <div class="container cabecalho-conteudo">
            <a href="/" class="logo">
                <img src="img/logo.png" alt="ConectField" width="150">
            </a>
            <nav class="menu">
                <a href="/">Início</a>
                <a href="/sobre">Sobre</a>
                <a href="/produtos">Produtos</a>
                <a href="/login" class="botao-admin">Área do Administrador</a>
            </nav>
        </div>
    </header>

    <!-- CONECT -->
    <main>
        <section class="conect" id="inicio">
            <div class="container conect-conteudo">
                <div class="conect-texto">
                    <h1>Controle total do seu estoque agrícola em tempo real.</h1>
                </div>
            </div>
        </section>
    </main>
</body>

</html>