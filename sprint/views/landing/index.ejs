<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ConectField</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <!-- CABEÇALHO -->
    <header class="cabecalho">
        <div class="container cabecalho-conteudo">
            <a href="/" class="logo">
                <img src="/img/logo.png" alt="ConectField" width="150">
            </a>
            <nav class="menu">
                <a href="#inicio">Início</a>
                <a href="#sobre">Sobre</a>
                <a href="#produtos">Produtos</a>
                <a href="#" class="botao-admin">Área do Administrador</a>
            </nav>
        </div>
    </header>

    <main>
        <!-- HERO -->
        <section class="conect" id="inicio">
            <div class="container conect-conteudo">
                <div class="conect-texto">
                    <h1>Controle total do seu estoque agrícola em tempo real.</h1>
                </div>
            </div>
        </section>

        <!-- SOBRE -->
        <section class="sobre" id="sobre">
            <div class="container">
                <h2>Sobre o ConectField</h2>
                <p>
                    O ConectField é um sistema de controle de estoque pensado para o
                    campo: cadastre produtos, registre entradas e saídas e acompanhe
                    tudo em tempo real.
                </p>
                <div class="resumo">
                    <div class="resumo-item">
                        <strong><%= produtos.length %></strong>
                        <span>Produtos ativos</span>
                    </div>
                    <div class="resumo-item">
                        <strong><%= categorias.length %></strong>
                        <span>Categorias</span>
                    </div>
                    <div class="resumo-item">
                        <strong><%= usuarios.length %></strong>
                        <span>Usuários</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- PRODUTOS -->
        <section class="produtos" id="produtos">
            <div class="container">
                <h2>Produtos em estoque</h2>

                <% if (produtos.length === 0) { %>
                    <p>Nenhum produto cadastrado.</p>
                <% } else { %>
                    <div class="tabela-wrapper">
                        <table>
                            <thead>
                                <tr>
                                    <th>Nome</th>
                                    <th>Categoria</th>
                                    <th>Estoque</th>
                                    <th>Mínimo</th>
                                    <th>Custo</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% produtos.forEach(p => { %>
                                    <tr class="<%= p.qnt_estoque <= p.estoque_min ? 'estoque-baixo' : '' %>">
                                        <td><%= p.nome %></td>
                                        <td><%= p.categoria || '—' %></td>
                                        <td><%= p.qnt_estoque %></td>
                                        <td><%= p.estoque_min %></td>
                                        <td>R$ <%= Number(p.custo).toFixed(2).replace('.', ',') %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </section>

        <!-- ÚLTIMAS MOVIMENTAÇÕES -->
        <section class="movimentacoes" id="movimentacoes">
            <div class="container">
                <h2>Últimas movimentações</h2>

                <% if (movimentacoes.length === 0) { %>
                    <p>Nenhuma movimentação registrada.</p>
                <% } else { %>
                    <div class="tabela-wrapper">
                        <table>
                            <thead>
                                <tr>
                                    <th>Data</th>
                                    <th>Produto</th>
                                    <th>Tipo</th>
                                    <th>Quantidade</th>
                                    <th>Estoque restante</th>
                                    <th>Usuário</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% movimentacoes.forEach(m => { %>
                                    <tr>
                                        <td><%= new Date(m.data).toLocaleDateString('pt-BR') %></td>
                                        <td><%= m.produto || '—' %></td>
                                        <td>
                                            <span class="tag <%= m.tipo === 'ENTRADA' ? 'tag-entrada' : 'tag-saida' %>">
                                                <%= m.tipo %>
                                            </span>
                                        </td>
                                        <td><%= m.quantidade %></td>
                                        <td><%= m.estoque_rest %></td>
                                        <td><%= m.usuario || '—' %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </section>
    </main>

    <footer class="rodape">
        <div class="container">
            <p>© <%= new Date().getFullYear() %> ConectField. Todos os direitos reservados.</p>
        </div>
    </footer>
</body>

</html>